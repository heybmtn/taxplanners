---
// Hub page (all regions) and taxonomy index pages (all terms).
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';
import SearchBar from '../../components/SearchBar.astro';
import site from '../../../site.config.ts';
import { loadData, isIndexable, type Region } from '../../lib/data.ts';
import { hubPage, taxonomies } from '../../lib/pages.ts';
import { cap } from '../../lib/format.ts';

export async function getStaticPaths() {
  const { regions, terms, published } = await loadData();
  return [
    { params: { section: site.hub }, props: { kind: 'hub' as const, regions, total: published.length } },
    ...taxonomies(terms).map((t) => ({ params: { section: t.segment }, props: { kind: 'tax' as const, tax: t } })),
  ];
}
const p = Astro.props as any;
const page = p.kind === 'hub' ? hubPage(p.regions, p.total) : null;
const tax = p.kind === 'tax' ? p.tax : null;
const taxCount = tax ? tax.terms.reduce((n: number, t: any) => n + t.listings.length, 0) : 0;
---
{page && (
  <Base title={page.title} description={page.description} path={page.path} noindex={page.noindex} crumbs={page.crumbs}>
    <div class="wrap">
      <div class="page-head">
        <h1>{page.h1}</h1>
        <p class="lead">{p.total > 0 ? `${p.total} ${p.total === 1 ? site.entity.singular : site.entity.plural} listed in ${p.regions.length} ${p.regions.length === 1 ? site.regionWord : `${site.regionWord}s`}. Pick a ${site.regionWord}, or search by city or ZIP.` : ''}</p>
      </div>
      {p.regions.length === 0 ? (
        <EmptyState icon="building" title="We're building the directory" text={`We're currently adding ${site.professional}s. If you're a ${site.professional}, you can add your business for free.`} actions={[{ label: 'List your business', href: '/add-your-business/', primary: true }]} />
      ) : (
        <>
          <SearchBar compact idPrefix="hub" />
          <h2 style="margin-top:2rem">All {site.regionWord}s with listings</h2>
          <ul class="state-grid">
            {p.regions.map((r: Region) => <li><a class="state-link" href={r.url}>{r.name} <span class="count">{r.listings.length}</span></a></li>)}
          </ul>
        </>
      )}
    </div>
  </Base>
)}
{tax && (
  <Base title={`${cap(tax.segment.replace(/-/g, ' '))} | ${site.name}`} description={`${cap(site.entity.plural)} grouped by ${tax.segment.replace(/-/g, ' ')}.`} path={`/${tax.segment}/`} noindex={!isIndexable(taxCount)} crumbs={[{ name: 'Home', url: '/' }, { name: cap(tax.segment.replace(/-/g, ' ')), url: `/${tax.segment}/` }]}>
    <div class="wrap">
      <div class="page-head"><h1>{tax.title}</h1></div>
      <ul class="state-grid">
        {tax.terms.map((t: any) => <li><a class="state-link" href={t.url}>{t.label} <span class="count">{t.listings.length}</span></a></li>)}
      </ul>
    </div>
  </Base>
)}
