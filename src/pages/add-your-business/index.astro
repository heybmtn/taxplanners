---
// Three-step form. Without JavaScript all steps show in order; with it, one step at a time.
// The Worker adds a signed form token and fills in ?listing= and ?tier=verified (src/worker.ts).
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import site from '../../../site.config.ts';
import { attributeDefs, weekdays } from '../../lib/schema.ts';
import { dayNames } from '../../lib/format.ts';
import { plansUrl } from '../../lib/copy.ts';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || site.turnstileSiteKey || (import.meta.env.DEV ? '1x00000000000000000000AA' : '');
const e = site.entity;
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const attrs = Object.entries(attributeDefs);
const multi = attrs.filter(([, d]) => d.type === 'multi') as [string, { label: string; options: Record<string, string> }][];
const meetingKeys = Object.keys(site.meetingFormats);
const bools = attrs.filter(([k, d]) => d.type === 'bool' && !meetingKeys.includes(k));
const lists = attrs.filter(([, d]) => d.type === 'list');
const steps = [
  { id: 'step-business', title: 'Business' },
  { id: 'step-services', title: 'Services' },
  { id: 'step-verify', title: 'Contact & verification' },
];
---
<Base title={`List your business: add or update a ${e.singular} | ${site.name}`} description={`Add your ${e.singular} to ${site.name} for free, send a correction, or request a Verified listing. Three short steps.`} path="/add-your-business/" crumbs={[{ name: 'Home', url: '/' }, { name: 'List your business', url: '/add-your-business/' }]}>
  {siteKey && <script is:inline slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <div class="wrap">
    <div class="page-head">
      <h1>List your business</h1>
      <p class="lead">Add a {e.singular} or correct an existing listing. Basic listings are free; Verified is {site.verifiedPrice}. <a href={plansUrl}>Compare plans</a></p>
    </div>
    <div id="update-note" class="alert alert-info" hidden style="margin-bottom:1rem;max-width:44rem"></div>

    <ol class="stepper wizard-steps" aria-label="Form progress" style="max-width:44rem">
      {steps.map((s, i) => <li><a href={`#${s.id}`} data-step={i} aria-current={i === 0 ? 'step' : undefined}><span class="label">{s.title}</span></a></li>)}
    </ol>
    <p id="step-status" class="visually-hidden" aria-live="polite"></p>

    <form class="wizard" method="post" action="/add-your-business/">
      <input type="hidden" name="listing" value="" />
      <input type="hidden" name="form_token" value="" />
      <div class="hp" aria-hidden="true"><label for="f-hp">Leave this empty</label><input id="f-hp" type="text" name="company_url" tabindex="-1" autocomplete="off" /></div>

      <section class="wizard-step" id="step-business" data-title="Business" aria-labelledby="h-business">
        <h2 id="h-business" tabindex="-1">1. Business</h2>
        <div class="field"><label for="f-name">Business name <span class="hint">Required</span></label><input id="f-name" type="text" name="name" required minlength="2" maxlength="120" autocomplete="organization" /></div>
        <div class="field"><label for="f-street">Street address</label><input id="f-street" type="text" name="street" maxlength="200" autocomplete="address-line1" /></div>
        <div class="field-row">
          <div class="field"><label for="f-locality">City <span class="hint">Required</span></label><input id="f-locality" type="text" name="locality" required maxlength="80" autocomplete="address-level2" /></div>
          <div class="field"><label for="f-region">{cap(site.regionWord)} <span class="hint">Required, e.g. TX</span></label><input id="f-region" type="text" name="region" required minlength="2" maxlength="40" autocomplete="address-level1" /></div>
          <div class="field"><label for="f-postal">ZIP code</label><input id="f-postal" type="text" name="postalCode" maxlength="12" autocomplete="postal-code" inputmode="numeric" /></div>
        </div>
        <div class="field-row">
          <div class="field"><label for="f-phone">Phone</label><input id="f-phone" type="tel" name="phone" maxlength="40" autocomplete="tel" /></div>
          <div class="field"><label for="f-website">Website</label><input id="f-website" type="text" inputmode="url" name="website" maxlength="300" placeholder="example.com" autocomplete="url" /></div>
        </div>
        <div class="field"><label for="f-sameas">Social or profile links <span class="hint">One per line, starting with https://</span></label><textarea id="f-sameas" name="sameAs" rows="2" maxlength="1000"></textarea></div>
        <details class="more">
          <summary>Opening hours (optional)</summary>
          <p class="hint">For example "9:00-17:00" or "closed".</p>
          <div class="field-row">
            {weekdays.map((d) => <div class="field"><label for={`f-h-${d}`}>{dayNames[d]}</label><input id={`f-h-${d}`} type="text" name={`hours_${d}`} maxlength="40" /></div>)}
          </div>
        </details>
        <div class="step-nav js-only"><span></span><button type="button" class="btn btn-primary" data-next>Next: services <Icon name="arrow" /></button></div>
      </section>

      <section class="wizard-step" id="step-services" data-title="Services" aria-labelledby="h-services">
        <h2 id="h-services" tabindex="-1">2. Services</h2>
        <p class="muted small">Tick what applies. Everything here is optional.</p>
        {multi.map(([key, def]) => (
          <fieldset>
            <legend>{def.label}</legend>
            <div class="check-grid">{Object.entries(def.options).map(([k, label]) => <label class="check"><input type="checkbox" name={key} value={k} /> {label}</label>)}</div>
          </fieldset>
        ))}
        <fieldset>
          <legend>Meeting format</legend>
          <div class="check-grid">{meetingKeys.map((k) => <label class="check"><input type="checkbox" name={k} value="yes" /> {(site.meetingFormats as Record<string, string>)[k]}</label>)}</div>
        </fieldset>
        <fieldset>
          <legend>Other details</legend>
          <div class="check-grid">{bools.map(([k, def]) => <label class="check"><input type="checkbox" name={k} value="yes" /> {def.label}</label>)}</div>
        </fieldset>
        {lists.map(([k, def]) => <div class="field"><label for={`f-${k}`}>{def.label} <span class="hint">Comma separated, e.g. English, Spanish</span></label><input id={`f-${k}`} type="text" name={k} maxlength="200" /></div>)}
        <div class="field"><label for="f-desc">Short description <span class="hint">What you do and who you help. Shown only on Verified listings.</span></label><textarea id="f-desc" name="description" rows="4" maxlength="1200"></textarea></div>
        <div class="step-nav js-only"><button type="button" class="btn btn-ghost" data-back>Back</button><button type="button" class="btn btn-primary" data-next>Next: contact <Icon name="arrow" /></button></div>
      </section>

      <section class="wizard-step" id="step-verify" data-title="Contact and verification" aria-labelledby="h-verify">
        <h2 id="h-verify" tabindex="-1">3. Contact &amp; verification</h2>
        <fieldset>
          <legend>Listing plan</legend>
          <div class="tier-cards">
            <label class="tier-card"><input type="radio" name="tier" value="basic" checked /> <span><strong>Basic (free)</strong><span class="hint">Listed with the details you send and the date they were last updated.</span></span></label>
            <label class="tier-card"><input type="radio" name="tier" value="verified" /> <span><strong>Verified ({site.verifiedPrice})</strong><span class="hint">Owners and staff only. We check the credential and confirm the details with you before the badge appears.</span></span></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>About you <span class="hint">Never published</span></legend>
          <div class="field-row">
            <div class="field"><label for="f-sname">Your name <span class="hint">Required</span></label><input id="f-sname" type="text" name="submitterName" required maxlength="100" autocomplete="name" /></div>
            <div class="field"><label for="f-semail">Your email <span class="hint">Required</span></label><input id="f-semail" type="email" name="submitterEmail" required maxlength="200" autocomplete="email" /></div>
          </div>
          <div class="field"><label for="f-rel">Your relationship to the business</label>
            <select id="f-rel" name="relationship" required>
              <option value="owner">Owner</option>
              <option value="staff">Staff member</option>
              <option value="customer">Customer or other (sending a correction)</option>
            </select>
          </div>
        </fieldset>
        <label class="check"><input type="checkbox" name="consent" value="yes" required /> I confirm these details are accurate and agree to be contacted about this listing. <span class="visually-hidden">(required)</span></label>
        {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} style="margin:1rem 0"></div>}
        <div class="step-nav">
          <button type="button" class="btn btn-ghost js-only" data-back>Back</button>
          <button class="btn btn-primary btn-lg" type="submit">Send listing details</button>
        </div>
        <p class="muted small" style="margin-top:1rem">Your submission is emailed to us and not stored on this site. See <a href="/privacy/">privacy</a>.</p>
      </section>
    </form>
  </div>
</Base>
