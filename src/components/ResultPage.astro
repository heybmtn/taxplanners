---
// Shared layout for the form's outcome pages.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import site from '../../site.config.ts';
interface Props { title: string; heading: string; path: string; kind: 'success' | 'info' | 'error' }
const { title, heading, path, kind } = Astro.props;
const icon = kind === 'success' ? 'check-circle' : kind === 'error' ? 'info' : 'info';
---
<Base title={`${title} | ${site.name}`} description={heading} path={path} noindex twin={false}>
  <div class="wrap" style="max-width:44rem;padding-top:2.5rem">
    <div class:list={['alert', `alert-${kind}`]} role={kind === 'error' ? 'alert' : 'status'} style="padding:1.5rem">
      <Icon name={icon} class="alert-icon" />
      <div class="stack">
        <h1 style="font-size:1.5rem;margin:0">{heading}</h1>
        <slot />
      </div>
    </div>
  </div>
</Base>
