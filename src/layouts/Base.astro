---
import '../theme.css';
import '../styles/global.css';
import site from '../../site.config.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VerifiedInfo from '../components/VerifiedInfo.astro';
import { abs, breadcrumbLd, type Crumb } from '../lib/seo.ts';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonld?: object[];
  crumbs?: Crumb[];
  /** Markdown twin path (defaults to {path}index.md). false = none. */
  twin?: string | false;
}
const { title, description, path, noindex = false, jsonld = [], crumbs, twin } = Astro.props;
const canonical = abs(path);
const twinPath = twin === false ? null : (twin ?? `${path}index.md`);
const ld = [...jsonld, ...(crumbs ? [breadcrumbLd(crumbs)] : [])];
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    {twinPath && <link rel="alternate" type="text/markdown" href={twinPath} title="Markdown version" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#102a43" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {ld.map((j) => <script type="application/ld+json" is:inline set:html={JSON.stringify(j)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      {crumbs && (
        <nav class="crumbs wrap" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c, i) => (
              <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.url}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <Footer />
    <VerifiedInfo />
    <script>
      import '../scripts/enhance.ts';
    </script>
  </body>
</html>
