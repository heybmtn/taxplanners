---
import type { Listing } from '../lib/schema.ts';
import { optionLabels } from '../lib/format.ts';
interface Props { l: Listing }
const creds = optionLabels(Astro.props.l, 'credentials', true);
---
{creds.length > 0 && <ul class="tags" aria-label="Credentials">{creds.map((c) => <li><span class="badge-cred">{c}</span></li>)}</ul>}
