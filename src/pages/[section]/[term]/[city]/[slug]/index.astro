---
// Listing profiles (/{hub}/{region}/{city}/{slug}/) and city landing pages per service, client type or
// credential (/{hub}/{region}/{city}/{option}/, only with 3+ listings). data.ts guarantees the two never clash.
import Base from '../../../../../layouts/Base.astro';
import ListingProfile from '../../../../../components/ListingProfile.astro';
import LocationResults from '../../../../../components/LocationResults.astro';
import site from '../../../../../../site.config.ts';
import { loadData, nearby, type City, type Entry, type Facet, type Region } from '../../../../../lib/data.ts';
import { facetPage } from '../../../../../lib/pages.ts';
import { itemListLd } from '../../../../../lib/seo.ts';

export async function getStaticPaths() {
  const { all, regions, published } = await loadData();
  const paths = [];
  for (const l of all) {
    const region = regions.find((r) => r.slug === l.region);
    const city = region?.cities.find((c) => c.slug === l.city);
    // Closed listings whose city has no published listings get no page.
    if (!region || !city) continue;
    paths.push({ params: { section: site.hub, term: l.region, city: l.city, slug: l.slug }, props: { l, region, city, near: nearby(l, published) } });
  }
  for (const region of regions)
    for (const city of region.cities)
      for (const facet of city.facets) paths.push({ params: { section: site.hub, term: region.slug, city: city.slug, slug: facet.key }, props: { facet, region, city } });
  return paths;
}
const props = Astro.props as { l?: Entry; near?: Entry[]; facet?: Facet; region: Region; city: City };
const { region, city } = props;
const fp = props.facet ? facetPage(props.facet, city, region) : null;
const sp = props.facet ? new URLSearchParams({ location: `${city.name}, ${region.abbr}`, [props.facet.attr]: props.facet.key }).toString() : '';
---
{props.l && <ListingProfile l={props.l} region={region} city={city} near={props.near ?? []} />}
{props.facet && fp && (
  <Base title={fp.title} description={fp.description} path={fp.path} noindex={fp.noindex} crumbs={fp.crumbs} jsonld={[itemListLd(fp.h1, props.facet.listings)]}>
    <div class="wrap">
      <div class="page-head">
        <h1>{fp.h1}</h1>
        <p class="lead">{fp.intro}</p>
      </div>
      <LocationResults listings={props.facet.listings} place={city.name} searchParams={sp} heading={`${props.facet.listings.length} matching ${site.entity.plural}`} />
      <p><a href={city.url}>All {site.entity.plural} in {city.name}</a> · <a href={`/search/?${sp}`}>Refine this search</a></p>
    </div>
  </Base>
)}
