{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taxplanners",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs only for search, the form and the Verified thanks page; everything else is static.
    "run_worker_first": ["/search/", "/add-your-business/", "/add-your-business/thanks-verified/"]
  },
  // Email Routing: the destination must be a verified address in the Cloudflare dashboard.
  "send_email": [{ "name": "EMAIL", "destination_address": "hello@taxplanners.com" }],
  // Daily rebuild via the Workers Builds deploy hook (secret DEPLOY_HOOK_URL), so expired Verified listings drop to Basic.
  "triggers": { "crons": ["17 5 * * *"] },
  // Form spam protection: at most 5 submissions per IP per minute (no setup needed).
  "ratelimits": [{ "name": "FORM_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true }
  // Secrets (dashboard: Settings > Variables & Secrets): FORM_SECRET (recommended), TURNSTILE_SECRET (optional), DEPLOY_HOOK_URL
}
