---
import site from '../../site.config.ts';
import Logo from './Logo.astro';
import { formUrl, plansUrl } from '../lib/copy.ts';
const path = Astro.url.pathname;
const links = [
  { href: '/search/', label: `Find a ${site.entity.singular}` },
  { href: `/${site.hub}/`, label: `Browse by ${site.regionWord}` },
  { href: '/verification/', label: 'How verification works' },
  { href: plansUrl, label: 'Pricing' },
  { href: '/about/', label: 'About' },
];
---
<header class="site-header">
  <div class="wrap">
    <Logo />
    <nav aria-label="Main">
      <button type="button" class="menu-toggle" popovertarget="main-menu" aria-label="Open menu">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Menu
      </button>
      <ul id="main-menu" class="nav-list" popover>
        {links.map((l) => <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
        <li><a class="btn btn-primary btn-sm" href={formUrl}>List your business</a></li>
      </ul>
    </nav>
  </div>
</header>
