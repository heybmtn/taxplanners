{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taxplanners",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs only for the form and the Verified thanks page; everything else is static.
    "run_worker_first": ["/add-your-business/", "/add-your-business/thanks-verified/"]
  },
  // Email Routing: the destination must be a verified address in the Cloudflare dashboard.
  "send_email": [{ "name": "EMAIL", "destination_address": "hello@taxplanners.com" }],
  // Daily rebuild via the Workers Builds deploy hook (secret DEPLOY_HOOK_URL), so expired Verified listings drop to Basic.
  "triggers": { "crons": ["17 5 * * *"] },
  "observability": { "enabled": true }
  // Secrets: TURNSTILE_SECRET, DEPLOY_HOOK_URL (dashboard: Settings > Variables & Secrets)
}
