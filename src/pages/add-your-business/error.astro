---
import ResultPage from '../../components/ResultPage.astro';
import site from '../../../site.config.ts';
---
<ResultPage title="Something went wrong" heading="Sorry, we couldn't send your details" path="/add-your-business/error/" kind="error">
  <p>Something went wrong on our side and your details were not sent. Please try again in a few minutes, or email them to <a href={`mailto:${site.submissionsEmail}`}>{site.submissionsEmail}</a>.</p>
  <div class="btn-row"><a class="btn btn-primary" href="/add-your-business/">Try again</a></div>
</ResultPage>
