---
// Hub page (all regions) and taxonomy index pages (all terms).
import Base from '../../layouts/Base.astro';
import site from '../../../site.config.ts';
import { loadData, isIndexable, type Region } from '../../lib/data.ts';
import { hubPage, taxonomies } from '../../lib/pages.ts';
import { cap } from '../../lib/format.ts';

export async function getStaticPaths() {
  const { regions, terms, published } = await loadData();
  return [
    { params: { section: site.hub }, props: { kind: 'hub' as const, regions, total: published.length } },
    ...taxonomies(terms).map((t) => ({ params: { section: t.segment }, props: { kind: 'tax' as const, tax: t } })),
  ];
}
const p = Astro.props as any;
const page = p.kind === 'hub' ? hubPage(p.regions, p.total) : null;
const tax = p.kind === 'tax' ? p.tax : null;
const taxCount = tax ? tax.terms.reduce((n: number, t: any) => n + t.listings.length, 0) : 0;
---
{page && (
  <Base title={page.title} description={page.description} path={page.path} noindex={page.noindex} crumbs={page.crumbs}>
    <h1>{page.h1}</h1>
    {p.regions.length === 0 && <p>No listings yet. <a href="/add-your-business/">Add the first one</a>.</p>}
    <ul class="grid-links">
      {p.regions.map((r: Region) => <li><a href={r.url}>{r.name} <span>{r.listings.length}</span></a></li>)}
    </ul>
  </Base>
)}
{tax && (
  <Base title={`${cap(tax.segment.replace(/-/g, ' '))} | ${site.name}`} description={`${cap(site.entity.plural)} grouped by ${tax.segment.replace(/-/g, ' ')}.`} path={`/${tax.segment}/`} noindex={!isIndexable(taxCount)} crumbs={[{ name: 'Home', url: '/' }, { name: cap(tax.segment.replace(/-/g, ' ')), url: `/${tax.segment}/` }]}>
    <h1>{tax.title}</h1>
    <ul class="grid-links">
      {tax.terms.map((t: any) => <li><a href={t.url}>{t.label} <span>{t.listings.length}</span></a></li>)}
    </ul>
  </Base>
)}
