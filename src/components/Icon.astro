};
interface Props { name: keyof typeof paths | string; label?: string; class?: string }
const { name, label, class: cls } = Astro.props;
---
<svg class={cls} width="1.15em" height="1.15em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} focusable="false" set:html={paths[name]} />
