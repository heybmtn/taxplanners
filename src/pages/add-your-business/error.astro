---
import Base from '../../layouts/Base.astro';
import site from '../../../site.config.ts';
---
<Base title={`Something went wrong | ${site.name}`} description="Your listing details could not be sent." path="/add-your-business/error/" noindex twin={false}>
  <h1>Sorry, your details were not sent</h1>
  <p>Please check the form and <a href="/add-your-business/">try again</a>, or email the details to <a href={`mailto:${site.submissionsEmail}`}>{site.submissionsEmail}</a>.</p>
</Base>
