---
// Questions and answers as native disclosure widgets (keyboard accessible, no JavaScript).
interface Props { faqs: readonly { q: string; a: string }[]; heading?: string; id?: string }
const { faqs, heading = 'Questions', id = 'faqs' } = Astro.props;
---
{faqs.length > 0 && (
  <section class="faq" aria-labelledby={id}>
    <h2 id={id}>{heading}</h2>
    {faqs.map((f, i) => (
      <details open={i === 0}>
        <summary><h3>{f.q}</h3></summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
)}
