---
import ResultPage from '../../components/ResultPage.astro';
import site from '../../../site.config.ts';
---
<ResultPage title="Listing submitted" heading="Thanks — your listing has been submitted." path="/add-your-business/thanks/" kind="success">
  <p>We'll review the information and contact you if anything else is needed. Approved changes usually appear within a few days, marked with the date they were updated.</p>
  <div class="btn-row"><a class="btn btn-primary" href="/">Back to the home page</a><a class="btn btn-secondary" href={`/${site.hub}/`}>Browse {site.entity.plural}</a></div>
</ResultPage>
