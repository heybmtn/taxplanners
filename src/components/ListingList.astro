---
// A list of listing cards with the paid-placement disclosure (Verified listings are shown first).
import type { Entry } from '../lib/data.ts';
import { copy, plansUrl } from '../lib/copy.ts';
import ListingCard from './ListingCard.astro';
interface Props { listings: Entry[]; heading?: string; headingId?: string }
const { listings, heading, headingId = 'listings' } = Astro.props;
---
<section aria-labelledby={heading ? headingId : undefined}>
  {heading && <h2 id={headingId}>{heading}</h2>}
  <p class="disclosure">{copy.disclosure} <a href={plansUrl}>{copy.disclosureLink}</a></p>
  <ul class="results">
    {listings.map((l) => <ListingCard l={l} />)}
  </ul>
</section>
