---
import type { Entry } from '../lib/data.ts';
import { copy, plansUrl } from '../lib/copy.ts';
import ListingCard from './ListingCard.astro';
interface Props { listings: Entry[]; showCity?: boolean; heading?: string }
const { listings, showCity = false, heading } = Astro.props;
---
{heading && <h2>{heading}</h2>}
<p class="disclosure">{copy.disclosure} <a href={plansUrl}>{copy.disclosureLink}</a></p>
<ul class="cards">
  {listings.map((l) => <ListingCard l={l} showCity={showCity} />)}
</ul>
